DATABASE_URL=postgres://aromazone:devpassword@localhost:55432/aromazone
PORT=4000
SESSION_COOKIE_NAME=az_session
ADMIN_SESSION_COOKIE_NAME=az_admin_session
# Comma-separated allowed origin(s) for the separate admin/ frontend (its
# own repo/deploy) — CORS is only needed for /api/admin/*, everything else
# is same-origin. Defaults to the admin/ Vite dev server's port.
ADMIN_ORIGIN=http://localhost:5173
# Production — MUST be punycode (browsers send Origin in punycode, compared
# as a plain string):
# ADMIN_ORIGIN=https://admin.xn----7sba2axiddn1aal.xn--p1ai
# Optional — SOCKS5 proxy for the catalog sync job's outbound requests
# (Algolia catalog fetch + product image downloads, see
# api/src/services/proxyDispatcher.ts). Only needed if this server's own
# network can't reach Aroma-Zone's Algolia index / image CDN directly;
# leave unset for a direct connection.
# CATALOG_SYNC_PROXY=socks5h://127.0.0.1:1080
# Unisender Go API key from the transactional account. Keep it on the server.
UNISENDER_API_KEY=
UNISENDER_API_URL=https://go2.unisender.ru/ru/transactional/api/v1
# Bare email address on a domain verified with SPF and DKIM in Unisender Go.
EMAIL_FROM=no-reply@email.xn--80aavshcdl.xn--p1ai
EMAIL_FROM_NAME=Аромазон-тут
# Mailbox where replies and website contact messages are received.
EMAIL_REPLY_TO=aromazone.tut@gmail.com
CONTACT_EMAIL=aromazone.tut@gmail.com
PUBLIC_WEB_URL=https://xn--80aavshcdl.xn--p1ai
